@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.PaginadoResultado<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<h1>Propietarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Propietario</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control"
               placeholder="Buscar por DNI, nombre o apellido..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Dni</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Fecha de nacimiento</th>
            <th>Dirección</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Dni</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                <td>@item.Direccion</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdPropietario" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdPropietario" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPaginas; p++)
            {
                <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@p" asp-route-busqueda="@Model.Busqueda">@p</a>
                </li>
            }
        </ul>
    </nav>
}