@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h1>Nueva Reserva</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group position-relative">
        <label>Inquilino</label>
        <input type="text" id="inputInquilino" class="form-control" autocomplete="off"
               placeholder="Buscar por DNI, nombre o apellido..." />
        <input type="hidden" asp-for="IdInquilino" />
        <div id="listaInquilino" class="list-group position-absolute w-100"
             style="z-index:1000; display:none; max-height:200px; overflow-y:auto;"></div>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="form-group position-relative">
        <label>Inmueble</label>
        <input type="text" id="inputInmueble" class="form-control" autocomplete="off"
               placeholder="Buscar por dirección..." />
        <input type="hidden" asp-for="IdInmueble" />
        <div id="listaInmueble" class="list-group position-absolute w-100"
             style="z-index:1000; display:none; max-height:200px; overflow-y:auto;"></div>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Monto por día</label>
        <input type="text" id="montoPorDiaDisplay" class="form-control" readonly
               placeholder="Se completa al elegir el inmueble" />
        <small class="form-text text-muted">
            Se toma automáticamente del precio actual del inmueble. Si querés cambiarlo, hacelo luego
            desde "Editar" en el listado de reservas.
        </small>
    </div>

    <div class="form-group">
        <label asp-for="FechaDesde"></label>
        <input asp-for="FechaDesde" class="form-control" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaHasta"></label>
        <input asp-for="FechaHasta" class="form-control" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/buscador-servidor.js"></script>
    <script>
        inicializarBuscadorServidor({
        inputId: 'inputInquilino',
        hiddenId: 'IdInquilino',
        listaId: 'listaInquilino',
        url: '@Url.Action("Buscar", "Inquilino")'
        });

        inicializarBuscadorServidor({
        inputId: 'inputInmueble',
        hiddenId: 'IdInmueble',
        listaId: 'listaInmueble',
        url: '@Url.Action("Buscar", "Inmueble")',
        onSeleccionar: function (item) {
        document.getElementById('montoPorDiaDisplay').value =
        new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(item.precio);
        }
        });
    </script>
}