@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
}

<h1>Editar Reserva</h1>

<div class="alert alert-info">
    El inquilino y el inmueble de una reserva ya creada no se pueden cambiar (para no perder la trazabilidad
    de los pagos ya registrados). Solo podés ajustar fechas y monto.
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdReserva" />
    <input type="hidden" asp-for="IdInquilino" />
    <input type="hidden" asp-for="IdInmueble" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label>Inquilino</label>
        <input type="text" class="form-control" value="@Model.NombreInquilino" readonly />
    </div>

    <div class="form-group">
        <label>Inmueble</label>
        <input type="text" class="form-control" value="@Model.DireccionInmueble" readonly />
    </div>

    <div class="form-group">
        <label asp-for="MontoPorDia"></label>
        <input asp-for="MontoPorDia" class="form-control" />
        <span asp-validation-for="MontoPorDia" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaDesde"></label>
        <input asp-for="FechaDesde" class="form-control" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaHasta"></label>
        <input asp-for="FechaHasta" class="form-control" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}