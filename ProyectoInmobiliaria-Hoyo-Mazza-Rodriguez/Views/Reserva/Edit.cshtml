@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar Reserva";
}

<h1>Editar Reserva</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdReserva" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="IdInquilino"></label>
        <select asp-for="IdInquilino" class="form-control" asp-items="@((List<SelectListItem>)ViewBag.Inquilinos)">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdInmueble"></label>
        <select asp-for="IdInmueble" class="form-control" asp-items="@((List<SelectListItem>)ViewBag.Inmuebles)">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MontoPorDia"></label>
        <input asp-for="MontoPorDia" class="form-control" />
        <span asp-validation-for="MontoPorDia" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaDesde"></label>
        <input asp-for="FechaDesde" class="form-control" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaHasta"></label>
        <input asp-for="FechaHasta" class="form-control" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
