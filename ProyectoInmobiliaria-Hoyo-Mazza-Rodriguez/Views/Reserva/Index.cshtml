@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.PaginadoResultado<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Reserva</a>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control"
               placeholder="Buscar por inquilino o dirección del inmueble..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Buscar</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Monto/día</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.NombreInquilino</td>
                <td>@item.DireccionInmueble</td>
                <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                <td>
                    @item.FechaHasta.ToString("dd/MM/yyyy")
                    @if (item.IdReservaOrigen.HasValue)
                    {
                        <span class="badge bg-secondary" title="Renovación de la reserva #@item.IdReservaOrigen">Renovación</span>
                    }
                </td>
                <td>@item.MontoPorDia.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Renovar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-primary">Renovar</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                    <a asp-controller="Pago" asp-action="Index" asp-route-idReserva="@item.IdReserva" class="btn btn-sm btn-success">Pagos</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPaginas; p++)
            {
                <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@p" asp-route-busqueda="@Model.Busqueda">@p</a>
                </li>
            }
        </ul>
    </nav>
}