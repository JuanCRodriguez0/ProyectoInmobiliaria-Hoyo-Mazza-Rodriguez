@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    Layout = "_Layout";
}

<h1>Ingresar</h1>

<form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="col-md-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Clave"></label>
        <input asp-for="Clave" class="form-control" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Ingresar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}