@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.PaginadoResultado<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<h1>Inmuebles</h1>

<div class="btn-group mb-3" role="group">
    <a asp-action="Index" asp-route-busqueda="@Model.Busqueda"
       class="btn btn-outline-secondary @(ViewBag.FiltroDisponible == null ? "active" : "")">Todos</a>
    <a asp-action="Index" asp-route-disponible="true" asp-route-busqueda="@Model.Busqueda"
       class="btn btn-outline-secondary @(ViewBag.FiltroDisponible == true ? "active" : "")">Disponibles</a>
    <a asp-action="Index" asp-route-disponible="false" asp-route-busqueda="@Model.Busqueda"
       class="btn btn-outline-secondary @(ViewBag.FiltroDisponible == false ? "active" : "")">Suspendidos</a>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Inmueble</a>
</p>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="disponible" value="@ViewBag.FiltroDisponible" />
    <div class="col-md-4">
        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control"
               placeholder="Buscar por dirección, propietario o tipo..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Buscar</button>
    </div>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Portada</th>
            <th>Dirección</th>
            <th>Tipo</th>
            <th>Propietario</th>
            <th>Cupo</th>
            <th>Precio/día</th>
            <th>Disponible</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.Portada))
                    {
                        <img src="@item.Portada" alt="" style="width:60px;height:45px;object-fit:cover;" />
                    }
                    else
                    {
                        <span class="text-muted">Sin imagen</span>
                    }
                </td>
                <td>@item.Direccion</td>
                <td>@item.DescripcionTipo</td>
                <td>@item.NombrePropietario</td>
                <td>@item.Cupo</td>
                <td>@item.PrecioPorDia.ToString("C")</td>
                <td>@(item.Disponible ? "Sí" : "Suspendido")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPaginas; p++)
            {
                <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@p"
                       asp-route-busqueda="@Model.Busqueda" asp-route-disponible="@ViewBag.FiltroDisponible">@p</a>
                </li>
            }
        </ul>
    </nav>
}