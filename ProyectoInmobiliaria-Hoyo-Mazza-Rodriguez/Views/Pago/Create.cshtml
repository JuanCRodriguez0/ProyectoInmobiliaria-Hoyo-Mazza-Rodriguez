@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Pago

@{
    ViewData["Title"] = "Registrar pago";

    var reserva = ViewBag.Reserva as ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva;
}

<div class="container mt-4">

    <h2>Registrar pago</h2>

    @if (reserva != null)
    {
        <div class="alert alert-info">

            <strong>Reserva #@reserva.IdReserva</strong>

            <br />

            Inquilino:
            @(reserva.NombreInquilino ?? "No especificado")

            <br />

            Inmueble:
            @(reserva.DireccionInmueble ?? "No especificado")

        </div>
    }

    <form asp-action="Create" method="post">

        <input type="hidden"
               asp-for="IdReserva" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Concepto"
                   class="form-label">
            </label>

            <input asp-for="Concepto"
                   class="form-control"
                   placeholder="Ej: Seña, pago parcial, pago total..." />

            <span asp-validation-for="Concepto"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="FechaPago"
                   class="form-label">
            </label>

            <input asp-for="FechaPago"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="FechaPago"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Importe"
                   class="form-label">
            </label>

            <input asp-for="Importe"
                   type="number"
                   step="0.01"
                   min="0.01"
                   class="form-control" />

            <span asp-validation-for="Importe"
                  class="text-danger">
            </span>

        </div>

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-success">
                Registrar pago
            </button>

            <a asp-action="Index"
               asp-route-idReserva="@Model.IdReserva"
               class="btn btn-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}