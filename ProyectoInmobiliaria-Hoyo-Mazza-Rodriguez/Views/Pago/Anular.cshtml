@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Pago

@{
    ViewData["Title"] = "Anular pago";
}

<div class="container mt-4">

    <h2>Anular pago</h2>


    <div class="alert alert-warning">

        <strong>¿Está seguro de que desea anular este pago?</strong>

        <br />

        El pago no será eliminado de la base de datos.

        <br />

        Quedará registrado como <strong>anulado</strong>.

    </div>


    <div class="card mb-4">

        <div class="card-body">

            <dl class="row">


                <dt class="col-sm-3">
                    ID
                </dt>

                <dd class="col-sm-9">
                    @Model.IdPago
                </dd>


                <dt class="col-sm-3">
                    Reserva
                </dt>

                <dd class="col-sm-9">
                    #@Model.IdReserva
                </dd>


                <dt class="col-sm-3">
                    Concepto
                </dt>

                <dd class="col-sm-9">
                    @Model.Concepto
                </dd>


                <dt class="col-sm-3">
                    Fecha
                </dt>

                <dd class="col-sm-9">
                    @Model.FechaPago.ToString("dd/MM/yyyy")
                </dd>


                <dt class="col-sm-3">
                    Importe
                </dt>

                <dd class="col-sm-9">
                    $ @Model.Importe.ToString("N2")
                </dd>

            </dl>

        </div>

    </div>


    <form asp-action="Anular"
          asp-route-id="@Model.IdPago"
          method="post">

        @Html.AntiForgeryToken()


        <button type="submit"
                class="btn btn-danger">
            Sí, anular pago
        </button>


        <a asp-action="Index"
           asp-route-idReserva="@Model.IdReserva"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>