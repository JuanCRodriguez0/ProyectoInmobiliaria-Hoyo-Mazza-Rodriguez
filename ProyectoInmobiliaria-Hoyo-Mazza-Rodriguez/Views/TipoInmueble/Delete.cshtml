@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.TipoInmueble

@{
    ViewData["Title"] = "Eliminar Tipo de Inmueble";
}

<h1>¿Eliminar este tipo de inmueble?</h1>

@if (ViewBag.TieneInmuebles == true)
{
    <div class="alert alert-warning">
        Este tipo tiene inmuebles cargados y no se puede eliminar.
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdTipoInmueble" />
    <button type="submit" class="btn btn-danger" disabled="@(ViewBag.TieneInmuebles == true)">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>