@model List<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Inmueble>
@{
    ViewData["Title"] = "Disponibilidad entre fechas";
    DateTime? desde = ViewBag.Desde;
    DateTime? hasta = ViewBag.Hasta;
}

<h1>Disponibilidad entre fechas</h1>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label">Desde</label>
        <input type="date" name="desde" value="@desde?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Hasta</label>
        <input type="date" name="hasta" value="@hasta?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
else if (desde.HasValue && hasta.HasValue)
{
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No hay inmuebles disponibles para ese rango de fechas.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Dirección</th>
                    <th>Tipo</th>
                    <th>Cupo</th>
                    <th>Precio/día</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-controller="Inmueble" asp-action="Details" asp-route-id="@item.IdInmueble">@item.Direccion</a></td>
                        <td>@item.DescripcionTipo</td>
                        <td>@item.Cupo</td>
                        <td>@item.PrecioPorDia.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}