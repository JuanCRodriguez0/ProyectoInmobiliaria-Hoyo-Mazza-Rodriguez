@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.PaginadoResultado<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva>
@{
    ViewData["Title"] = "Reservas vigentes";
}

<h1>Reservas vigentes hoy (@DateTime.Today.ToString("dd/MM/yyyy"))</h1>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No hay reservas vigentes en este momento.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Monto/día</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.NombreInquilino</td>
                    <td>@item.DireccionInmueble</td>
                    <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td>@item.MontoPorDia.ToString("C")</td>
                    <td>
                        <a asp-controller="Reserva" asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info">Detalles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int p = 1; p <= Model.TotalPaginas; p++)
                {
                    <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="ReservasVigentes" asp-route-pagina="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}