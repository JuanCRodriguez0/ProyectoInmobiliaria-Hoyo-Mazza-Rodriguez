@model List<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva>
@{
    ViewData["Title"] = "Reservas vigentes";
}

<h1>Reservas vigentes hoy (@DateTime.Today.ToString("dd/MM/yyyy"))</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay reservas vigentes en este momento.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Monto/día</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreInquilino</td>
                    <td>@item.DireccionInmueble</td>
                    <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td>@item.MontoPorDia.ToString("C")</td>
                    <td>
                        <a asp-controller="Reserva" asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info">Detalles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}