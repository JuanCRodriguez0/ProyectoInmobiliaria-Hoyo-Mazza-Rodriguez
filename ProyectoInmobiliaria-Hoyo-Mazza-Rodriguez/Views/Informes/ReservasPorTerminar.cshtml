@model ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.PaginadoResultado<ProyectoInmobiliaria_Hoyo_Mazza_Rodriguez.Models.Reserva>
@{
    ViewData["Title"] = "Reservas que terminan pronto";
    int dias = ViewBag.Dias;
}

<h1>Reservas que terminan en los próximos @dias días</h1>

<div class="btn-group mb-3" role="group">
    <a asp-action="ReservasPorTerminar" asp-route-dias="7" class="btn btn-outline-secondary @(dias == 7 ? "active" : "")">7 días</a>
    <a asp-action="ReservasPorTerminar" asp-route-dias="15" class="btn btn-outline-secondary @(dias == 15 ? "active" : "")">15 días</a>
    <a asp-action="ReservasPorTerminar" asp-route-dias="30" class="btn btn-outline-secondary @(dias == 30 ? "active" : "")">30 días</a>
</div>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label">Otro plazo (días)</label>
        <input type="number" name="dias" value="@dias" min="1" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No hay reservas que terminen en ese plazo.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Termina el</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.NombreInquilino</td>
                    <td>@item.DireccionInmueble</td>
                    <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-controller="Reserva" asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-controller="Reserva" asp-action="Renovar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-primary">Renovar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int p = 1; p <= Model.TotalPaginas; p++)
                {
                    <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="ReservasPorTerminar" asp-route-pagina="@p" asp-route-dias="@dias">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}